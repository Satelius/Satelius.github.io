+"""USD readback checks for inputs that used to be silently accepted."""
+
+import pytest
+
+from tacharness.agenticsim.generation.scene_gen.scene_mutator import SceneMutation, SceneMutator
+
+Usd = pytest.importorskip("pxr.Usd")
+from pxr import UsdGeom, Gf
+
+
+def test_move_updates_existing_translation_and_missing_targets_are_rejected(tmp_path):
+    base = tmp_path / "base.usda"
+    stage = Usd.Stage.CreateNew(str(base))
+    cube = UsdGeom.Cube.Define(stage, "/Part")
+    cube.AddTranslateOp().Set(Gf.Vec3d(1, 0, 0))
+    stage.GetRootLayer().Save()
+    mutator = SceneMutator()
+    result = mutator.mutate(
+        base, [SceneMutation("move_object", "/Part", {"delta_position": [0.03, 0, 0]})]
+    )
+    assert result.is_valid
+    readback = Usd.Stage.Open(str(result.mutated_usd))
+    assert readback.GetPrimAtPath("/Part").GetAttribute("xformOp:translate").Get()[0] == pytest.approx(
+        1.03
+    )
+    bad = mutator.mutate(base, [SceneMutation("remove_object", "/Missing")], tmp_path / "missing.usda")
+    assert not bad.is_valid and not bad.mutations_applied
