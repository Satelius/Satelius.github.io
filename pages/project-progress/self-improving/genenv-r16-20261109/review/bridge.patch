+++ b/scripts/agentic/probe_generated_layout.py
@@ -0,0 +1,299 @@
+"""Replay a generated RoboLab task with a privileged Cartesian grasp/place probe.
+
+Run inside the RoboLab Sim environment with the gujie rollout helpers on PYTHONPATH.
+Every attempted reset has a separate trace, video and summary.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import subprocess
+
+import cv2
+import numpy as np
+import torch
+from isaaclab.app import AppLauncher
+
+parser = argparse.ArgumentParser(__doc__)
+parser.add_argument("--task", type=Path, required=True)
+parser.add_argument("--object", required=True)
+parser.add_argument("--target", required=True)
+parser.add_argument("--seeds", type=int, nargs="+", required=True)
+parser.add_argument("--grasp-yaw", type=float, default=0.0, help="relative world z rotation in degrees")
+parser.add_argument(
+    "--grasp-height", type=float, default=0.001, help="TCP height above the object origin in metres"
+)
+parser.add_argument("--out", type=Path, required=True)
+args = parser.parse_args()
+scene_record = args.task.with_name(args.task.name.removesuffix("_task.py") + ".scene_ir.json")
+identity = json.loads(scene_record.read_text())
+roles = {entry["role"]: entry["asset_id"] for entry in identity["entities"]}
+if (args.object, args.target) != (roles.get("manipuland"), roles.get("target")):
+    parser.error("probe object and target must match the registered task roles")
+if not identity["goal"]["predicate"].startswith("inside("):
+    parser.error("this probe measures an inside-container goal")
+args.out.mkdir(parents=True, exist_ok=False)
+app = AppLauncher(headless=True, enable_cameras=True, device="cuda:0").app
+
+
+def run():
+    from gpt_rollout.sim import contact_center_pose, positions_in_base_frame, seed_everything, uint8_rgb
+    from robolab.constants import set_output_dir, TASK_DIR
+    from robolab.core.task.task_utils import resolve_task_path
+    from robolab.core.environments.runtime import create_env
+    from robolab.core.environments.factory import get_envs
+    from robolab.core.world.world_state import get_world
+    from robolab.core.task.conditionals import object_in_container
+    from robolab.registrations.droid.auto_env_registrations_abs_ik import auto_register_droid_abs_ik_envs
+
+    set_output_dir(str(args.out))
+    task = str(args.task.resolve())
+    auto_register_droid_abs_ik_envs(task=[task])
+    task_name = resolve_task_path(task, TASK_DIR)[1]
+    (env_id,) = get_envs(task=[task_name])
+    env, _ = create_env(env_id, device="cuda:0", num_envs=1, policy="gpt")
+    try:
+        for trial, seed in enumerate(args.seeds):
+            out = args.out / f"trial-{trial}-s{seed}"
+            out.mkdir()
+            env.reset_eval_state()
+            seed_everything(env, seed)
+            obs, _ = env.reset(seed=seed)
+            robot = env.scene["robot"]
+            obj, target = args.object, args.target
+            world = get_world(env)
+
+            def positions():
+                values = {k: world.get_pose(k, is_relative=False, env_id=0)[0] for k in (obj, target)}
+                return positions_in_base_frame(robot, values)
+
+            def speed(field):
+                value = getattr(env.scene[obj].data, field)
+                return float(getattr(value, "torch", value).reshape(-1, 3)[0].norm())
+
+            def instant():
+                return bool(
+                    object_in_container(
+                        env,
+                        object=obj,
+                        container=target,
+                        require_contact_with=True,
+                        require_gripper_detached=True,
+                        tolerance=0.0,
+                        env_id=0,
+                    )
+                )
+
+            observed = positions()
+            initial = {k: v.tolist() for k, v in observed.items()}
+            tcp, quat = contact_center_pose(env)
+            if args.grasp_yaw:
+                from robolab.core.utils.quat_order import isaaclab_initial_state_rot_order
+                from scipy.spatial.transform import Rotation
+
+                order = isaaclab_initial_state_rot_order()
+                orientation = Rotation.from_quat(quat, scalar_first=(order == "wxyz"))
+                quat = (Rotation.from_euler("z", args.grasp_yaw, degrees=True) * orientation).as_quat(
+                    scalar_first=(order == "wxyz")
+                )
+            hold = tcp.copy()
+            dt = float(env.step_dt)
+            phase = "settle"
+            dwell = steps = stable = max_stable = 0
+            native = lifted = ever_grasped = False
+            peak = float(observed[obj][2])
+            offset = np.zeros(3)
+            reason = "timeout"
+            video = subprocess.Popen(
+                [
+                    "ffmpeg",
+                    "-loglevel",
+                    "error",
+                    "-f",
+                    "rawvideo",
+                    "-pix_fmt",
+                    "rgb24",
+                    "-s",
+                    "640x360",
+                    "-r",
+                    str(1 / dt),
+                    "-i",
+                    "pipe:0",
+                    "-c:v",
+                    "libx264",
+                    "-threads",
+                    "2",
+                    "-pix_fmt",
+                    "yuv420p",
+                    "-movflags",
+                    "+faststart",
+                    str(out / "scene.mp4"),
+                ],
+                stdin=subprocess.PIPE,
+            )
+            with (out / "steps.jsonl").open("x") as trace:
+                try:
+                    for index in range(int(env.max_episode_length)):
+                        observed = positions()
+                        p, b = observed[obj], observed[target]
+                        tcp, _ = contact_center_pose(env)
+                        if phase == "settle":
+                            goal = hold
+                        elif phase == "approach":
+                            goal = p + [0, 0, 0.115]
+                        elif phase == "descend":
+                            goal = p + [0, 0, args.grasp_height]
+                        elif phase == "close":
+                            goal = hold
+                        elif phase == "lift":
+                            goal = hold + [0, 0, 0.14]
+                        elif phase == "carry":
+                            goal = np.r_[b[:2] - offset[:2], b[2] + 0.15]
+                        elif phase == "lower":
+                            goal = np.r_[b[:2] - offset[:2], b[2] + 0.065]
+                        elif phase == "release":
+                            goal = hold
+                        else:
+                            goal = hold + [0, 0, 0.12]
+                        delta = goal - tcp
+                        position = tcp + delta * min(
+                            1.0, 0.015 / max(1.0e-9, float(np.linalg.norm(delta)))
+                        )
+                        close = phase in ("close", "lift", "carry", "lower")
+                        command = np.r_[position, quat, float(close)].astype(np.float32)
+                        obs, _, terminated, truncated, _ = env.step(
+                            torch.from_numpy(command).to(env.device)[None, :]
+                        )
+                        steps += 1
+                        frame = cv2.resize(
+                            uint8_rgb(obs["image_obs"]["over_shoulder_left_camera"][0]), (640, 360)
+                        )
+                        video.stdin.write(frame.tobytes())
+                        measured = positions()
+                        peak = max(peak, float(measured[obj][2]))
+                        contact = bool(world.in_contact(obj, "gripper", env_id=0))
+                        pair_contact = bool(world.in_contact(obj, target, env_id=0))
+                        support = bool(world.is_supported_on_surface(obj, target, env_id=0))
+                        support_force = world.get_contact_force(obj, target, env_id=0).tolist()
+                        clear = float(np.linalg.norm(contact_center_pose(env)[0] - hold)) >= 0.05
+                        vx, va = speed("root_lin_vel_w"), speed("root_ang_vel_w")
+                        raw = instant()
+                        native = bool(env.get_env_results()[0]["success"])
+                        stable = (
+                            stable + 1
+                            if phase == "withdraw"
+                            and clear
+                            and raw
+                            and not contact
+                            and support
+                            and vx < 0.02
+                            and va < 0.2
+                            else 0
+                        )
+                        max_stable = max(max_stable, stable)
+                        ever_grasped |= close and contact
+                        lifted |= ever_grasped and peak - initial[obj][2] > 0.04
+                        row = dict(
+                            step=steps,
+                            phase=phase,
+                            action=command.tolist(),
+                            pose={k: v.tolist() for k, v in measured.items()},
+                            tcp=contact_center_pose(env)[0].tolist(),
+                            gripper_contact=contact,
+                            target_contact=pair_contact,
+                            upward_support=support,
+                            target_force_N=support_force,
+                            retreated=clear,
+                            linear_speed=vx,
+                            angular_speed=va,
+                            instant_success=raw,
+                            stable_steps=stable,
+                            native=native,
+                        )
+                        trace.write(json.dumps(row) + "\n")
+                        dwell += 1
+                        near = np.linalg.norm(contact_center_pose(env)[0] - goal) < 0.012
+                        if native or bool(terminated.any()) or bool(truncated.any()):
+                            reason = (
+                                "native_success"
+                                if native
+                                else "terminated"
+                                if bool(terminated.any())
+                                else "timeout"
+                            )
+                            break
+                        if phase == "settle" and dwell >= 15:
+                            phase = "approach"
+                            dwell = 0
+                        elif phase == "approach" and near:
+                            phase = "descend"
+                            dwell = 0
+                        elif phase == "descend" and near:
+                            hold = contact_center_pose(env)[0].copy()
+                            phase = "close"
+                            dwell = 0
+                        elif phase == "close" and dwell >= 18:
+                            if not contact:
+                                reason = "no_grasp_contact"
+                                break
+                            offset = measured[obj] - contact_center_pose(env)[0]
+                            phase = "lift"
+                            dwell = 0
+                        elif phase == "lift" and near:
+                            if not lifted:
+                                reason = "no_lift"
+                                break
+                            phase = "carry"
+                            dwell = 0
+                        elif phase == "carry" and near:
+                            phase = "lower"
+                            dwell = 0
+                        elif phase == "lower" and near:
+                            hold = contact_center_pose(env)[0].copy()
+                            phase = "release"
+                            dwell = 0
+                        elif phase == "release" and dwell >= 8:
+                            phase = "withdraw"
+                            dwell = 0
+                        elif phase == "withdraw" and dwell >= 60:
+                            reason = "placement_failed"
+                            break
+                        elif dwell > 95:
+                            reason = f"{phase}_stalled"
+                            break
+                finally:
+                    video.stdin.close()
+                    if video.wait() != 0:
+                        raise RuntimeError("Video encoding failed")
+            scene = args.task.with_name(args.task.name.removesuffix("_task.py") + ".usda")
+            summary = dict(
+                rule="upward-support-retreat-v2",
+                task=str(args.task),
+                task_sha256=hashlib.sha256(args.task.read_bytes()).hexdigest(),
+                scene_sha256=hashlib.sha256(scene.read_bytes()).hexdigest(),
+                seed=seed,
+                grasp_yaw_deg=args.grasp_yaw,
+                grasp_height_m=args.grasp_height,
+                initial_base_xyz=initial,
+                steps=steps,
+                dt=dt,
+                native=native,
+                peak_lift_m=peak - initial[obj][2],
+                grasp=ever_grasped,
+                lift=lifted,
+                max_stable_s=max_stable * dt,
+                qualified=native and lifted and max_stable >= math.ceil(0.5 / dt),
+                reason=reason,
+            )
+            (out / "result.json").write_text(json.dumps(summary, indent=2))
+            print(summary, flush=True)
+    finally:
+        env.close()
+
+
+try:
+    run()
+finally:
+    app.close()
