+def test_chinese_banana_placement_keeps_the_moving_object_as_source():
+    spec = parse_rule_based("在碗的左侧放一根香蕉。", seed=7)
+    assert any(r.relation == RelationType.LEFT_OF and r.source == "banana_1" and r.target == "bowl_1"
+               for r in spec.relations)
+
+
+def test_teal_remains_an_asset_constraint():
+    spec = parse_rule_based("A teal cube on the table.", seed=8)
+    assert spec.objects[0].color == "teal"
