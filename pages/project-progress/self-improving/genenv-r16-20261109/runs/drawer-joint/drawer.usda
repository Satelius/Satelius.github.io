#usda 1.0
(
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def "Render" (
    hide_in_stage_window = true
    no_delete = true
)
{
    def "OmniverseKit"
    {
        def "HydraTextures" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxSettingsParticleFieldAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </OmniverseKit_Persp>
                token omni:rtx:ambientOcclusion:denoiserMode = "none"
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
                token omni:rtx:background:source:type = "domeLight"
                bool omni:rtx:debug:view:pixelDebug:enableFixedTextPos = 1
                token omni:rtx:directLighting:sampledLighting:denoisingTechnique = "None"
                bool omni:rtx:dlss:frameGeneration = 0
                bool omni:rtx:indirectDiffuse:denoiser:enabled = 0
                bool omni:rtx:material:db:syncLoads = 1
                token omni:rtx:post:dlss:execMode = "performance"
                bool omni:rtx:post:registeredCompositing:invertColorCorrection = 1
                bool omni:rtx:post:registeredCompositing:invertToneMap = 1
                bool omni:rtx:pt:adaptiveSampling:filterError = 0
                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                int omni:rtx:pt:clampSpp = 64
                uint omni:rtx:pt:limits:maxBounces = 3
                uint omni:rtx:pt:limits:maxGlossyBounces = 3
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
                uint omni:rtx:pt:mgpu:maxPixelsPerRegionExponent = 12
                int omni:rtx:pt:samplesPerIteration = 64
                uint omni:rtx:pt:samplesPerPixel = 64
                bool omni:rtx:reflections:denoiser:enabled = 0
                token omni:rtx:rendermode = "RealTimePathTracing"
                color3f omni:rtx:rt:ambientLight:color = (0.1, 0.1, 0.1)
                bool omni:rtx:rt:demoire = 0
                bool omni:rtx:rt:lightcache:spatialCache:dontResolveConflicts = 1
                int omni:rtx:rt:sss:samples = 1
                uint omni:rtx:rtpt:maxVolumeBounces = 15
                float omni:rtx:rtpt:modulatingRoughnessThreshold = 0.08
                bool omni:rtx:scene:hydra:materialSyncLoads = 1
                bool omni:rtx:scene:hydra:mdlMaterialWarmup = 1
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (640, 360)
            }

            def RenderProduct "Replicator" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxSettingsParticleFieldAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </Replicator/Camera_Xform/Camera>
                token omni:rtx:ambientOcclusion:denoiserMode = "none"
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
                token omni:rtx:background:source:type = "domeLight"
                bool omni:rtx:debug:view:pixelDebug:enableFixedTextPos = 1
                token omni:rtx:directLighting:sampledLighting:denoisingTechnique = "None"
                bool omni:rtx:dlss:frameGeneration = 0
                bool omni:rtx:indirectDiffuse:denoiser:enabled = 0
                bool omni:rtx:material:db:syncLoads = 1
                token omni:rtx:post:dlss:execMode = "performance"
                bool omni:rtx:post:registeredCompositing:invertColorCorrection = 1
                bool omni:rtx:post:registeredCompositing:invertToneMap = 1
                bool omni:rtx:pt:adaptiveSampling:filterError = 0
                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                int omni:rtx:pt:clampSpp = 64
                uint omni:rtx:pt:limits:maxBounces = 3
                uint omni:rtx:pt:limits:maxGlossyBounces = 3
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
                uint omni:rtx:pt:mgpu:maxPixelsPerRegionExponent = 12
                int omni:rtx:pt:samplesPerIteration = 64
                uint omni:rtx:pt:samplesPerPixel = 64
                bool omni:rtx:reflections:denoiser:enabled = 0
                token omni:rtx:rendermode = "RealTimePathTracing"
                color3f omni:rtx:rt:ambientLight:color = (0.1, 0.1, 0.1)
                bool omni:rtx:rt:demoire = 0
                bool omni:rtx:rt:lightcache:spatialCache:dontResolveConflicts = 1
                int omni:rtx:rt:sss:samples = 1
                uint omni:rtx:rtpt:maxVolumeBounces = 15
                float omni:rtx:rtpt:modulatingRoughnessThreshold = 0.08
                bool omni:rtx:scene:hydra:materialSyncLoads = 1
                bool omni:rtx:scene:hydra:mdlMaterialWarmup = 1
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (640, 360)
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = [
            </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>,
            </Render/OmniverseKit/HydraTextures/Replicator>,
        ]
    }

    def "Vars" (
        hide_in_stage_window = true
        no_delete = true
    )
    {
        def RenderVar "LdrColor" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            uniform string sourceName = "LdrColor"
            uniform token sourceType = "raw"
        }
    }
}

over "OmniverseKit_Persp"
{
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
}

def "World"
{
    def PhysicsScene "Physics" (
        prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.25, 0.33, 0.33)]
        double size = 1
        float3 xformOp:scale = (1, 0.78, 0.1)
        double3 xformOp:translate = (0, 0, -0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Back" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.35, 0.28, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.05, 0.43, 0.24)
        double3 xformOp:translate = (-0.19, 0, 0.13)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RailR" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.52, 0.35, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.42, 0.025, 0.21)
        double3 xformOp:translate = (0, -0.205, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RailL" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.52, 0.35, 0.18)]
        double size = 1
        float3 xformOp:scale = (0.42, 0.025, 0.21)
        double3 xformOp:translate = (0, 0.205, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Drawer" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.4
        double3 xformOp:translate = (0, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.72, 0.48, 0.23)]
            double size = 1
            float3 xformOp:scale = (0.32, 0.36, 0.025)
            double3 xformOp:translate = (0, 0, -0.07)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Face" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.68, 0.42, 0.18)]
            double size = 1
            float3 xformOp:scale = (0.026, 0.36, 0.15)
            double3 xformOp:translate = (0.15, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Handle" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.12, 0.17, 0.16)]
            double size = 1
            float3 xformOp:scale = (0.036, 0.1, 0.022)
            double3 xformOp:translate = (0.176, 0, 0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsPrismaticJoint "Slide" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 65
        float drive:linear:physics:maxForce = 150
        float drive:linear:physics:stiffness = 900
        float drive:linear:physics:targetPosition = 0
        uniform token physics:axis = "X"
        rel physics:body1 = </World/Drawer>
        point3f physics:localPos0 = (0, 0, 0.15)
        float physics:lowerLimit = 0
        float physics:upperLimit = 0.14
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 1400
    }
}

def Scope "Replicator"
{
    def Xform "Camera_Xform"
    {
        bool replicatorCameraXform
        bool replicatorXform = 1
        float3 xformOp:rotateXYZ = (65.91227, -9.541664e-15, 45.369644)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.85, -0.77, 0.59)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Camera "Camera" (
            prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
            append apiSchemas = ["OmniSensorAPI"]
        )
        {
            token cameraProjectionType = "pinhole"
            float4[] clippingPlanes = []
            float2 clippingRange = (1, 1000000)
            string crossCameraReferenceName
            float exposure:fStop = 5
            float exposure:responsivity = 1.1026709
            float exposure:time = 0.02
            float focalLength = 24
            float focusDistance = 400
            float fStop = 0
            float fthetaCx = 970.94244
            float fthetaCy = 600.3748
            float fthetaHeight = 1216
            float fthetaMaxFov = 200
            float fthetaPolyA = 0
            float fthetaPolyB = 0.00245
            float fthetaPolyC = 0
            float fthetaPolyD = 0
            float fthetaPolyE = 0
            float fthetaPolyF = 0
            float fthetaWidth = 1936
            float horizontalAperture = 20.955
            float horizontalApertureOffset = 0
            string omni:sensor:marketName = ""
            string omni:sensor:modelName = ""
            string omni:sensor:modelVendor = ""
            string omni:sensor:modelVersion = ""
            float omni:sensor:tickRate = 0
            float omni_col_sensor_col_tickRate
            float openCVFx = 731.7879
            float openCVFy = 731.7879
            float p0 = -0.00037
            float p1 = -0.00074
            token projection = "perspective"
            uniform token purpose = "default"
            float s0 = -0.00058
            float s1 = -0.00022
            float s2 = 0.00019
            float s3 = -0.0002
            double shutter:close = 0
            double shutter:open = 0
            uniform token stereoRole = "mono"
            float verticalApertureOffset = 0
            float3 xformOp:rotateXYZ = (0, -0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }

    def OmniGraph "SDGPipeline"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OgnGroup"
        {
            custom rel inputs:primsIn = </Replicator/Camera_Xform> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom rel inputs:primsIn1 (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "omni.replicator.core.OgnGroup"
            int node:typeVersion = 1
            custom rel outputs:prims (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
        }

        def OmniGraphNode "OgnGroup_01"
        {
            custom rel inputs:primsIn = </Replicator/Camera_Xform/Camera> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom rel inputs:primsIn1 (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "omni.replicator.core.OgnGroup"
            int node:typeVersion = 1
            custom rel outputs:prims (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
        }
    }
}

