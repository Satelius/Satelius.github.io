#usda 1.0

def Cube "Body" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsMassAPI"]
)
{
    rel material:binding:physics = </Surface>
    float physics:mass = 0.18
}

def Material "Surface" (
    prepend apiSchemas = ["PhysicsMaterialAPI"]
)
{
    float physics:dynamicFriction = 0.4
    float physics:staticFriction = 0.6

    def Shader "Texture"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @/workspace/summary-web/genenv-r16-20261109/assets/bowl-scene.png@
    }
}

