        "attempts": "v1-v7",
        "result": "Closed missing TacEx assets, torch-scatter, geometry helpers, and cuRobo native dependencies one failure at a time."
      },
      {
        "attempts": "v8-v23",
        "result": "Localized device, Isaac Lab source, UIPC stepping, camera startup, and Taxim/JAX CUDA-context failures with bounded diagnostics."
      },
      {
        "attempt": "v24",
        "result": "Forcing Taxim's Torch backend initialized both GelSight sensors; the remaining app update hang was traced to duplicate NVIDIA Vulkan ICD manifests."
      },
      {
        "attempts": "v25, v28, v29",
        "result": "A process-local single Vulkan ICD allowed the full environment setup to finish. All three stopped at the first robot reset because the PhysX tensor view and Isaac Lab indices disagreed on CPU versus CUDA placement."
      },
      {
        "attempt": "v26",
        "result": "A narrow CPU-index compatibility patch crossed the first call but exposed another CPU/GPU buffer-index mismatch in the actuator path; the patch was rejected and reverted."
      },
      {
        "attempt": "v27",
        "result": "Using physical cuda:1 without remapping was rejected because this USD/RTX path only supports cuda:0."
      }
    ],
    "runtime_findings": [
      {
        "finding": "Taxim backend selection",
        "evidence": "Taxim auto-selected JAX, which created a competing CUDA primary context inside Isaac. Selecting the supported Torch backend allowed both optical tactile sensors to initialize."
      },
      {
        "finding": "Vulkan device enumeration",
        "evidence": "Two NVIDIA ICD manifests enumerated every L40S twice and left app.update stuck. Restricting VK_ICD_FILENAMES to /etc/vulkan/icd.d/nvidia_icd.json removed the duplicate enumeration and let environment setup finish."
      },
      {
        "finding": "Remaining reset incompatibility",
        "evidence": "The installed Isaac Sim 5.1 / Isaac Lab variants create a CPU PhysX tensor view while the environment and index buffers are configured for cuda:0. A local index-only shim is insufficient and changes runtime semantics, so it was not accepted as a reproduction result."
      }
    ],
